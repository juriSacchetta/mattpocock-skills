{
  "name": "pi-agent-team",
  "version": "1.3.2",
  "private": true,
  "description": "Matt Pocock's engineering workflows adapted to a Pi agent team",
  "repository": {
    "type": "git",
    "url": "https://github.com/juriSacchetta/pi-agent-team"
  },
  "license": "MIT",
  "scripts": {
    "changeset": "changeset",
    "version": "changeset version && node scripts/sync-plugin-version.mjs",
    "check-plugin-version": "node scripts/sync-plugin-version.mjs --check",
    "test:pi": "node --test pi/tests/*.test.mjs"
  },
  "devDependencies": {
    "@changesets/changelog-github": "^0.7.0",
    "@changesets/cli": "^2.30.0"
  },
  "packageManager": "npm@10.9.4",
  "keywords": [
    "pi-package",
    "pi-skill",
    "pi-subagents"
  ],
  "pi": {
    "extensions": [
      "./pi/extensions/team-context.ts",
      "./pi/extensions/team-usage.ts"
    ],
    "skills": [
      "./pi/skills"
    ],
    "prompts": [],
    "themes": [],
    "subagents": {
      "agents": [
        "./pi/agents"
      ],
      "workflows": [
        "./pi/workflows"
      ]
    }
  }
}
